#!/usr/bin/env bash
{
# gfv.sh - launcher for gpu-fleet-validation @VERSION@. Source and docs: https://github.com/igladun/gpu-fleet-validation
#
# Downloads gfv.pyz from the v@VERSION@ release, checks its sha256 against GFV_SHA256 below, and runs it
# with python3 >= 3.10. gfv.pyz is a Python zipapp of the gfv/ sources and the bundled manifests
# (standard library only); list it with `python3 -m zipfile -l gfv.pyz`.
#
#   curl -fsSL https://github.com/igladun/gpu-fleet-validation/releases/download/v@VERSION@/gfv.sh | sudo bash -s -- accept --class hgx-h100-8x
#   sudo bash gfv.sh accept --class hgx-h100-8x
#   bash gfv.sh accept --class hgx-h100-8x --dry-run                 # print the plan, run nothing
#   sudo GFV_PYZ="$PWD/gfv.pyz" bash gfv.sh accept --class ...       # use a local copy (still sha256-checked)
#
# Generated by scripts/build-dist.sh from scripts/bootstrap.sh.in.
# The whole script is one { ... } block, so bash parses all of it before running any of it:
# a truncated download is a syntax error (exit 2) and runs nothing.
set -euo pipefail

GFV_VERSION="@VERSION@"
GFV_SHA256="@SHA256@"
GFV_URL="https://github.com/igladun/gpu-fleet-validation/releases/download/v@VERSION@/gfv.pyz"
gfv_tmp=""

gfv_die() {
  echo "gfv: $*" >&2
  exit 2
}

gfv_python_ok() {
  command -v python3 >/dev/null 2>&1 &&
    python3 -I -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null
}

gfv_ensure_python() {
  gfv_python_ok && return 0
  if [ "$(id -u)" -eq 0 ] && command -v apt-get >/dev/null 2>&1; then
    echo "gfv: installing python3" >&2
    { DEBIAN_FRONTEND=noninteractive apt-get update -qq &&
      DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3; } </dev/null >/dev/null 2>&1 ||
      echo "gfv: apt-get install python3 failed" >&2
  fi
  gfv_python_ok || gfv_die "python3 >= 3.10 is required"
}

gfv_fetch() { # $1: destination file
  if [ -n "${GFV_PYZ+set}" ]; then
    [ -n "$GFV_PYZ" ] || gfv_die "GFV_PYZ is set but empty"
    cp -- "$GFV_PYZ" "$1" || gfv_die "cannot read GFV_PYZ=$GFV_PYZ"
  elif command -v curl >/dev/null 2>&1; then
    curl -fsSL --proto '=https' --tlsv1.2 --connect-timeout 20 --max-time 600 --max-filesize 50000000 \
      --retry 3 -o "$1" "$GFV_URL" </dev/null || gfv_die "download failed: $GFV_URL"
  elif command -v wget >/dev/null 2>&1; then
    wget -q --tries=3 --timeout=30 -O "$1" "$GFV_URL" </dev/null || gfv_die "download failed: $GFV_URL"
  else
    gfv_die "need curl or wget to download $GFV_URL, or set GFV_PYZ to a local copy"
  fi
}

gfv_verify() { # $1: file
  local got
  got=$(python3 -I -c 'import hashlib, sys; print(hashlib.sha256(open(sys.argv[1], "rb").read()).hexdigest())' "$1") ||
    gfv_die "cannot hash $1"
  [ "$got" = "$GFV_SHA256" ] || gfv_die "gfv.pyz sha256 mismatch: got $got, want $GFV_SHA256; nothing was run"
}

gfv_main() {
  gfv_ensure_python
  gfv_tmp=$(mktemp -d "${TMPDIR:-/tmp}/gfv.XXXXXX") || gfv_die "mktemp failed"
  trap 'rm -rf -- "$gfv_tmp"' EXIT
  gfv_fetch "$gfv_tmp/gfv.pyz"
  gfv_verify "$gfv_tmp/gfv.pyz"
  echo "gfv: gfv.pyz $GFV_VERSION, sha256 $GFV_SHA256 verified" >&2
  # Hold the verified file open, delete it, and replace this shell with python3. Signals from the terminal,
  # sudo or kill then reach the runner itself, its exit code is the script's, and nothing is left behind.
  exec 3<"$gfv_tmp/gfv.pyz"
  [ -r /dev/fd/3 ] || gfv_die "/dev/fd is not available (is /proc mounted?)"
  rm -rf -- "$gfv_tmp"
  trap - EXIT
  # -I: isolated mode, so modules planted in the current directory are never imported (we run as root).
  exec python3 -I /dev/fd/3 "$@" </dev/null
}

gfv_main "$@"
}
