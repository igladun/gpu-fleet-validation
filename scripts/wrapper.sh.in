#!/usr/bin/env bash
# gfv-accept.sh - gpu-fleet-validation in one file (version @VERSION@, src @SOURCE@).
# Runs the L2 node acceptance gate on this host; installs the test tools it needs.
# Source and docs: https://github.com/igladun/gpu-fleet-validation
#
#   curl -fsSL https://raw.githubusercontent.com/igladun/gpu-fleet-validation/main/gfv-accept.sh | sudo bash -s -- accept --class hgx-h100-8x
#   sudo bash gfv-accept.sh accept --class hgx-h100-8x
#   bash gfv-accept.sh accept --class hgx-h100-8x --dry-run      # print the plan, run nothing
#
# Generated by scripts/build-dist.sh; do not edit. The payload below is a base64 Python zipapp
# (standard library only, Python >= 3.10).
# Everything is inside functions, so a truncated download runs nothing.
set -euo pipefail

gfv_python_ok() {
  command -v python3 >/dev/null 2>&1 &&
    python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null
}

gfv_main() {
  if ! gfv_python_ok; then
    if [ "$(id -u)" -eq 0 ] && command -v apt-get >/dev/null 2>&1; then
      echo "gfv: installing python3" >&2
      { DEBIAN_FRONTEND=noninteractive apt-get update -qq &&
        DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3; } </dev/null >/dev/null 2>&1 ||
        echo "gfv: apt-get install python3 failed" >&2
    fi
    gfv_python_ok || { echo "gfv: python3 >= 3.10 is required" >&2; exit 2; }
  fi
  local tmp rc=0
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/gfv.XXXXXX") || { echo "gfv: mktemp failed" >&2; exit 2; }
  # shellcheck disable=SC2064  # expand $tmp now: the trap runs after this function returns
  trap "rm -rf '$tmp'" EXIT
  # -I: isolated mode, so modules planted in the current directory are never imported (we run as root).
  gfv_payload | python3 -I -c 'import base64, sys; sys.stdout.buffer.write(base64.b64decode(sys.stdin.read()))' \
    >"$tmp/gfv.pyz" || { echo "gfv: could not unpack the payload" >&2; exit 2; }
  python3 -I "$tmp/gfv.pyz" "$@" </dev/null || rc=$?
  exit "$rc"
}

gfv_payload() {
  cat <<'GFV_PAYLOAD'
@PAYLOAD@
GFV_PAYLOAD
}

gfv_main "$@"
